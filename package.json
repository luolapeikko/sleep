{
  "name": "@luolapeikko/sleep",
  "version": "0.3.1",
  "description": "Sleep promise with Abort support",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --tsconfig tsconfig.build.json --sourcemap --format cjs,esm --dts --clean",
    "validate": "tsc --noEmit --project tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run --no-isolate --coverage",
    "coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
    "lint": "biome check"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16.9.0"
  },
  "repository": "github:luolapeikko/sleep",
  "keywords": [
    "sleep",
    "abortcontroller"
  ],
  "author": "mharj",
  "license": "LGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/luolapeikko/sleep/issues"
  },
  "homepage": "https://github.com/luolapeikko/sleep#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@luolapeikko/result-option": "^2.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "c8": "^12.0.0",
    "dotenv": "^18.0.0",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@luolapeikko/result-option": ">=1.0",
    "@opentelemetry/api": "^1.9"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
