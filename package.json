{
  "name": "@luolapeikko/sleep",
  "version": "0.3.0",
  "description": "Sleep promise with Abort support",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --tsconfig tsconfig.build.json --sourcemap --format cjs,esm --dts --clean",
    "validate": "tsc --noEmit --project tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run --no-isolate --coverage",
    "coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
    "lint": "biome check"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16.9.0"
  },
  "repository": "github:luolapeikko/sleep",
  "keywords": [
    "sleep",
    "abortcontroller"
  ],
  "author": "mharj",
  "license": "LGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/luolapeikko/sleep/issues"
  },
  "homepage": "https://github.com/luolapeikko/sleep#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@luolapeikko/result-option": "^2.2.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.213.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.0",
    "c8": "^11.0.0",
    "dotenv": "^17.3.1",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.21.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@luolapeikko/result-option": ">=1.0",
    "@opentelemetry/api": "^1.9"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
