{
  "name": "@luolapeikko/sleep",
  "version": "0.4.1",
  "description": "Sleep promise with Abort support",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --tsconfig tsconfig.build.json --minify --sourcemap --format cjs,esm --dts --clean",
    "validate": "tsc --noEmit --project tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run --no-isolate --coverage",
    "coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
    "lint": "biome check"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16.9.0"
  },
  "repository": "github:luolapeikko/sleep",
  "keywords": [
    "sleep",
    "abortcontroller"
  ],
  "author": "mharj",
  "license": "LGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/luolapeikko/sleep/issues"
  },
  "homepage": "https://github.com/luolapeikko/sleep#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@open-draft/deferred-promise": "^3.0.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "c8": "^12.0.0",
    "core-result": "^0.0.3",
    "dotenv": "^18.0.4",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
